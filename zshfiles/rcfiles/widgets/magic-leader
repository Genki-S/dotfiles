# vim: filetype=zsh

# magic-leader triggers useful things with leader key
# only works when LBUFFER is empty (i.e. when leader is first entered)

if [[ -n "$LBUFFER" ]]; then
  zle self-insert
  return
fi

__kubernetes_switch_context() {
  local contexts="$(bkt --ttl=12h --stale=60s -- kubectl config get-contexts | tail -n +2 | sed 's/^\*//' | sed 's/^\s*//' | sed 's/\s.*$//')"
  local selected="$(echo $contexts | fzy)"
  if [ -z "$selected" ]; then
    zle reset-prompt
    return
  fi
  LBUFFER="kubectl config use-context $selected"
  zle reset-prompt
  zle accept-line
}

__kubernetes_switch_namespace() {
  # TODO: show this on minibuffer
  LBUFFER="# collecting namespaces..."
  zle reset-prompt
  local namespaces="$(bkt --ttl=12h --stale=60s -- kubectl --context "$(kubectl config current-context)" get namespaces | tail -n +2 | awk '{ print $1 }')"
  LBUFFER=""
  local selected="$(echo $namespaces | fzy)"
  if [ -z "$selected" ]; then
    zle reset-prompt
    return
  fi
  # LBUFFER="kubectl config set-context --current --namespace $selected"
  LBUFFER="kns $selected"
  zle reset-prompt
  zle accept-line
}

__aws_switch_region() {
  local regions=("ap-northeast-1" "ap-northeast-2" "ap-northeast-3" "ap-south-1" "ap-southeast-1" "ap-southeast-2")
  regions+=("eu-central-1" "eu-north-1" "eu-west-1" "eu-west-2" "eu-west-3") 
  regions+=("us-east-1" "us-east-2" "us-west-1" "us-west-2")
  regions+=("ca-central-1" "sa-east-1")

  zle reset-prompt
  LBUFFER=""
  local selected="$(echo ${(F)regions} | fzy)"
  if [ -z "$selected" ]; then
    zle reset-prompt
    return
  fi
  # LBUFFER="kubectl config set-context --current --namespace $selected"
  LBUFFER="export AWS_REGION=$selected"
  zle reset-prompt
  zle accept-line
}

__aws_switch_profile() {
  # TODO: show this on minibuffer
  LBUFFER="# collecting aws profiles..."
  zle reset-prompt
  local profiles="$(bkt --ttl=12h --stale=60s -- aws configure list-profiles)"
  LBUFFER=""
  local selected="$(echo $profiles | fzy)"
  if [ -z "$selected" ]; then
    zle reset-prompt
    return
  fi
  LBUFFER="export AWS_PROFILE=$selected"
  zle reset-prompt
  zle accept-line
}

__aws_ssm_start_session() {
  if [[ -z "${AWS_PROFILE:-}" ]]; then
    zle -M "easy ssm: AWS_PROFILE is not set"
    return
  fi
  if [[ -z "${AWS_REGION:-}" ]]; then
    zle -M "easy ssm: AWS_REGION is not set"
    return
  fi

  setopt localoptions pipefail
  LBUFFER="# collecting ec2 instances..."
  zle reset-prompt
  local instances
  instances="$(aws ec2 describe-instances | jq -r '
    .Reservations[].Instances[] |
    [
      ((.Tags // [] | map(select(.Key == "Name")) | first | .Value) // "-"),
      .InstanceId,
      .State.Name,
      .PrivateIpAddress,
      .InstanceType,
      .Placement.AvailabilityZone,
      .LaunchTime
    ] | @tsv
  ' | column -t -s $'\t')"
  if [[ $? -ne 0 ]]; then
    LBUFFER=""
    zle reset-prompt
    zle -M "easy ssm: failed to list EC2 instances"
    return
  fi
  LBUFFER=""
  if [[ -z "$instances" ]]; then
    zle reset-prompt
    zle -M "easy ssm: no EC2 instances found"
    return
  fi

  local selected="$(print -r -- "$instances" | fzy)"
  if [[ -z "$selected" ]]; then
    zle reset-prompt
    return
  fi
  local instance_id="$(print -r -- "$selected" | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^i-[[:xdigit:]]+$/) { print $i; exit } }')"
  if [[ -z "$instance_id" ]]; then
    zle reset-prompt
    zle -M "easy ssm: could not read the selected instance ID"
    return
  fi
  LBUFFER="aws ssm start-session --target $instance_id"
  zle reset-prompt
  zle accept-line
}

local REPLY
read-from-minibuffer -k 1 "magic-leader: "
case "${REPLY}" in
  k)
    read-from-minibuffer -k 1 "k8s ([c]ontext, [n]amespace): "
    case "${REPLY}" in
      c)
        __kubernetes_switch_context
        ;;
      n)
        __kubernetes_switch_namespace
        ;;
    esac
    ;;
  a)
    read-from-minibuffer -k 1 "aws ([r]egion, [p]rofile, [s]sm): "
    case "${REPLY}" in
      r)
        __aws_switch_region
        ;;
      p)
        __aws_switch_profile
        ;;
      s)
        __aws_ssm_start_session
        ;;
    esac
    ;;
  *)
    zle -M "magic-leader: no action registered for key '$REPLY'"
esac
